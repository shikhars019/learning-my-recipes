# Environment Configuration for Learning My Recipes Backend
# Copy this file to .env and update the values

# Server Configuration
NODE_ENV=development
PORT=3001
HOST=localhost

# Database Configuration
DB_HOST=localhost
DB_PORT=5432
DB_NAME=learning_my_recipes
DB_USER=your_username
DB_PASSWORD=your_password
DB_SSL=false

# Security Configuration
JWT_SECRET=your_super_secret_jwt_key_change_this_in_production
JWT_EXPIRES_IN=7d
BCRYPT_ROUNDS=12

# API Rate Limiting
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100

# File Upload Configuration
UPLOAD_DIR=uploads
MAX_FILE_SIZE=5242880
ALLOWED_FILE_TYPES=image/jpeg,image/png,image/webp

# OpenAI Configuration (Optional - for AI recipe generation)
OPENAI_API_KEY=your_openai_api_key_here
OPENAI_MODEL=gpt-3.5-turbo
OPENAI_MAX_TOKENS=1000

# External APIs (Optional)
SPOONACULAR_API_KEY=your_spoonacular_api_key
EDAMAM_API_KEY=your_edamam_api_key
EDAMAM_API_ID=your_edamam_api_id

# Logging Configuration
LOG_LEVEL=info
LOG_FILE=logs/app.log

# CORS Configuration
CORS_ORIGIN=http://localhost:3000
CORS_CREDENTIALS=true

# Email Configuration (Optional - for user notifications)
EMAIL_SERVICE=gmail
EMAIL_USER=your_email@gmail.com
EMAIL_PASSWORD=your_app_password
EMAIL_FROM=Learning My Recipes <noreply@learningmyrecipes.com>

# Development Settings
DEBUG_MODE=true
ENABLE_SWAGGER=true
SWAGGER_PATH=/api-docs