# Environment Configuration for Learning My Recipes Frontend
# Copy this file to .env and update the values

# API Configuration
REACT_APP_API_URL=http://localhost:3001/api
REACT_APP_API_TIMEOUT=10000

# Application Configuration
REACT_APP_NAME=Learning My Recipes
REACT_APP_VERSION=1.0.0
REACT_APP_DESCRIPTION=Educational Recipe Application

# Feature Flags
REACT_APP_ENABLE_AI_RECIPES=true
REACT_APP_ENABLE_REVIEWS=true
REACT_APP_ENABLE_FAVORITES=true
REACT_APP_ENABLE_USER_PROFILES=true

# External Services (Optional)
REACT_APP_GOOGLE_ANALYTICS_ID=your_ga_tracking_id
REACT_APP_SENTRY_DSN=your_sentry_dsn

# Development Settings
REACT_APP_DEBUG_MODE=true
REACT_APP_MOCK_API=false

# File Upload Configuration
REACT_APP_MAX_FILE_SIZE=5242880
REACT_APP_ALLOWED_FILE_TYPES=image/jpeg,image/png,image/webp

# UI Configuration
REACT_APP_THEME_MODE=light
REACT_APP_PRIMARY_COLOR=#1976d2
REACT_APP_SECONDARY_COLOR=#dc004e

# Pagination Configuration
REACT_APP_DEFAULT_PAGE_SIZE=12
REACT_APP_MAX_PAGE_SIZE=50

# Cache Configuration
REACT_APP_CACHE_DURATION=300000